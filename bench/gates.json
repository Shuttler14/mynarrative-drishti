    {"id": "reco_error_rate", "source": "live", "metric": "error_rate_pct", "cmp": "<=", "value": 1.0},
    {"id": "reco_ready_latency", "source": "live", "metric": "reco_ready_ms_p95", "cmp": "<=", "value": 4000},
    {"id": "live_outfit_validity", "source": "live", "metric": "live_outfit_validity_pct", "cmp": ">=", "value": 99.0},
    {"id": "extraction_success", "source": "vton", "metric": "extraction_success_pct", "cmp": ">=", "value": 98.0},
    {"id": "vton_failure", "source": "vton", "metric": "vton_failure_pct", "cmp": "<=", "value": 1.0},
    {"id": "e2e_vton_latency", "source": "vton", "metric": "e2e_vton_ms_p95", "cmp": "<=", "value": 10000},
    {"id": "garment_leakage", "source": "vton_labels", "metric": "garment_leakage_pct", "cmp": "<=", "value": 2.0, "optional_if_unlabelled": true}
